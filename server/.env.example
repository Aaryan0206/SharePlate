# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Compatible with MongoDB Compass)
MONGODB_URI=mongodb://127.0.0.1:27017/shareplate

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d
PICKUP_CODE_SECRET=your_optional_dedicated_pickup_code_hmac_aes_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Provisioning Seed Defaults
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@shareplate.org
ADMIN_PASSWORD=Admin@SharePlate2026
ADMIN_PHONE=+1-555-0199
